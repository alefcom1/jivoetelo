# Скопируйте в .env и заполните.

# Пароль Postgres для docker-compose (сгенерируйте: openssl rand -hex 24).
POSTGRES_PASSWORD=

# Строка подключения для приложения и drizzle-kit.
# В docker-compose приложение получает её автоматически; эта переменная нужна
# для локальной разработки (npm run dev) и миграций (npm run db:migrate).
DATABASE_URL=postgresql://jivoetelo:<POSTGRES_PASSWORD>@localhost:5432/jivoetelo

# AI-разбор еды. Без ключей в бою разбор выключается, а не выдумывает цифры.
ANTHROPIC_API_KEY=
# Модель под каждую операцию отдельно (docs/ai-proxy.md) — умолчания разумны,
# трогать не обязательно:
#   ANTHROPIC_MODEL_VISION  — разбор фото, по умолчанию claude-sonnet-5
#   ANTHROPIC_MODEL_TEXT    — разбор текста, по умолчанию claude-haiku-4-5-20251001
#   ANTHROPIC_MODEL_SUGGEST — подсказки «что съесть дальше», по умолчанию claude-haiku-4-5-20251001
ANTHROPIC_MODEL_VISION=
ANTHROPIC_MODEL_TEXT=
ANTHROPIC_MODEL_SUGGEST=
# Старая переменная — обратная совместимость. Если задана, перекрывает все
# три модели выше разом (как было до того, как модель развели по задачам).
ANTHROPIC_MODEL=
# AI_PROVIDER: пусто — боевой AI; off — разбор и подсказки выключены,
# экраны предлагают ручной ввод; demo — заглушка для показа продукта
# (одно и то же блюдо на любую еду, живым пользователям не показывать).
AI_PROVIDER=

# Папка для фото еды (по умолчанию ./data/uploads; в Docker — том /app/data).
UPLOADS_DIR=

# Таймзона продукта для границы «сегодняшнего» дня (по умолчанию Europe/Moscow).
APP_TIMEZONE=

# Telegram Mini App и бот: токен от @BotFather.
# Без него /api/tg/* отвечает 503 — защита от запуска без проверки подписи.
TELEGRAM_BOT_TOKEN=

# Имя бота без «@» — для кнопки «Войти через Telegram» на /login и /register.
# Пусто — кнопки нет вовсе. Работает только после того, как в BotFather задан
# домен сайта (/setdomain или Bot Settings → Domain): виджет с чужого домена
# Telegram молча не выполняет вход.
TELEGRAM_BOT_USERNAME=

# Секрет вебхука бота (docs/bot.md). Придумайте сами: openssl rand -hex 32.
# Тот же секрет передаётся в setWebhook — по нему приложение отличает
# настоящий апдейт от постороннего запроса. Без него /api/tg/webhook
# отвечает 503, и бот просто не принимает фото.
TELEGRAM_WEBHOOK_SECRET=

# Адрес Bot API. Пусто — официальный api.telegram.org. С российского VPS он
# может быть недоступен (та же история, что с api.anthropic.com): тогда сюда
# подставляется прокси, см. docs/bot.md. Входящие апдейты от этого не зависят —
# их Telegram присылает нам сам; через прокси идут только ответы бота,
# getFile и скачивание фото.
TELEGRAM_API_BASE=

# Секрет прокси-воркера (тот же PROXY_SECRET, что и у ANTHROPIC_AUTH_TOKEN).
# Нужен только вместе с TELEGRAM_API_BASE: воркер пускает по нему, а до
# Telegram заголовок не доводит. Самому Bot API авторизация не нужна —
# токен бота лежит в пути запроса.
TELEGRAM_API_AUTH=

# Адрес Mini App для кнопки «Разобрать» под сообщениями бота. Задавайте
# ТОЛЬКО после того, как Mini App заведено в BotFather: Telegram отвергает
# web_app-кнопку с чужим доменом, и тогда сообщение не уйдёт совсем.
# Пусто — кнопка ведёт на веб-страницу /app/inbox, это всегда работает.
TELEGRAM_MINIAPP_URL=

# Порт на localhost, на котором приложение доступно reverse proxy.
# По умолчанию 3000. Менять, если порт уже занят другим приложением на том
# же сервере: сосед не подвинется, а наш контейнер не поднимется вовсе.
# Изменив здесь, поправьте proxy_pass в deploy/nginx/jivoetelo-proxy.conf.
APP_HOST_PORT=

# Абсолютный адрес сайта: подставляется в письма, в кнопки бота и в
# подписанные ссылки на снимки для модели (docs/ai-proxy.md). Обязан быть
# HTTPS: по нему на сервер придёт Anthropic, чтобы забрать фото. Если адрес
# не HTTPS, ссылки не выписываются и снимок уходит телом запроса — в проде
# это означает неработающий разбор фото. По умолчанию https://jivoetelo.ru.
SITE_URL=

# Ключ подписи ссылок на снимки. Пустой — и он генерируется случайно при
# старте: ссылки живут пять минут и переживать перезапуск не должны.
# Задавать нужно, только если приложение работает в нескольких экземплярах:
# тогда ссылку выписывает один процесс, а отдаёт другой.
PHOTO_LINK_SECRET=

# Отправка почты (docs/email-series.md). Без SMTP_* письма не уходят, а
# печатаются в лог — безопасное состояние по умолчанию. Ящик общий с
# techperevod; свой почтовый сервер мы не поднимаем.
# Поставщик почты для таблицы получателей в политике конфиденциальности
# (раздел «Кому мы передаём данные»). Пока пусто — документ честно пишет
# «уточняется». Заполнить обязательно до того, как включатся отчёты: они
# несут сведения о питании и вес.
LEGAL_MAIL_PROVIDER=
LEGAL_MAIL_PROVIDER_COUNTRY=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# EMAIL_ENABLED=false — заглушить отправку при заполненном SMTP.
EMAIL_ENABLED=

# SCHEDULER_ENABLED=false — не запускать фоновые задачи (письма и
# напоминания). Нужно, если контейнер поднят для миграций или отладки.
SCHEDULER_ENABLED=

# Anthropic через прокси-воркер (docs/ai-proxy.md). С российского VPS
# api.anthropic.com напрямую недоступен — ходим через proxy.techperevod.com
# на Hetzner. ANTHROPIC_API_KEY при этом не нужен: ключ живёт на воркере.
ANTHROPIC_BASE_URL=https://proxy.techperevod.com/api
ANTHROPIC_AUTH_TOKEN=

# Общий дневной потолок расходов на AI, USD (docs/free-tier.md).
# По умолчанию 25. Предохранитель от вирусного всплеска.
AI_DAILY_BUDGET_USD=

# Приём оплаты (Unitpay). Сейчас выключен — всё бесплатно (docs/payments.md).
# Ключи сами по себе ничего не включают: нужен явный PAYMENTS_ENABLED=true.
UNITPAY_PUBLIC_KEY=
UNITPAY_SECRET_KEY=
PAYMENTS_ENABLED=

# Админка раздела Живое Тело Pro (/admin): заявки в пилот и статусы
# специалистов. Админ — это адрес из списка ниже, а НЕ флаг в базе: флаг
# можно выставить случайно, переменную окружения — только через деплой.
# Формат: адреса через запятую, регистр и пробелы вокруг не важны, например
# ADMIN_EMAILS=you@jivoetelo.ru,partner@jivoetelo.ru
# Пусто или не задано — админов нет вообще, /admin отвечает 404 всем без
# исключения (не «пускать всех», как иногда по ошибке делают с пустым списком).
ADMIN_EMAILS=

# Реквизиты оператора персональных данных для страниц /legal/* (docs/legal.md).
# Пока пустые, документы честно пишут «будет указано после регистрации
# юридического лица». Заполнить сразу после регистрации ИП или ООО —
# пересборка образа не нужна, достаточно перезапустить контейнер.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_INN=
LEGAL_OPERATOR_OGRN=
LEGAL_OPERATOR_ADDRESS=
# Адрес для обращений субъектов ПДн. По умолчанию privacy@jivoetelo.ru.
LEGAL_CONTACT_EMAIL=

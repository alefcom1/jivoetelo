#!/bin/bash
# Не даёт закоммитить поверх устаревшей базы.
#
# Ровно это и случилось 30 июля: рабочая копия откатилась к более раннему
# состоянию, коммит лёг поверх него, и в него попал возврат уже исправленного
# файла на двадцать строк назад. Заметить удалось случайно — по тому, что
# тестов стало меньше. Второй раз так везти не должно.
#
# Хук нарочно не чинит ничего сам: коммит — момент, когда в дереве лежит
# незавершённая работа, и автоматическое слияние здесь опаснее отказа.
set -uo pipefail

[ -n "${ALLOW_STALE:-}" ] && exit 0

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
[ -z "$branch" ] || [ "$branch" = "HEAD" ] && exit 0

upstream="origin/$branch"
git rev-parse --verify --quiet "$upstream" >/dev/null || exit 0

# Без сети сравнивать не с чем — это не повод блокировать работу.
git fetch --quiet origin "$branch" 2>/dev/null || exit 0

behind="$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
[ "$behind" = "0" ] && exit 0

echo "" >&2
echo "ОТКАЗ: ветка отстала от $upstream на $behind коммитов." >&2
echo "" >&2
echo "Коммит поверх устаревшей базы вернёт назад то, что уже исправлено —" >&2
echo "это не гипотеза, так уже терялась работа." >&2
echo "" >&2
echo "Что сделать:" >&2
echo "  git stash                 # если в дереве есть нужное" >&2
echo "  git merge --ff-only $upstream" >&2
echo "  git stash pop" >&2
echo "" >&2
echo "Если вы точно знаете, что делаете: ALLOW_STALE=1 git commit ..." >&2
echo "" >&2
exit 1
